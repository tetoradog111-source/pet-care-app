<div class="container py-5 text-center">
  <h1 class="display-5 fw-bold" style="color: #7c2d12;"><%= @group.name %></h1>
  
  <div class="my-5 p-4 bg-light rounded shadow-sm">
    <p class="mb-1 text-muted">このグループの招待コード</p>
    <h2 class="display-6 fw-bold text-primary" style="letter-spacing: 0.1em;">
      <%= @group.invite_code %>
    </h2>
    <p class="mt-3 small text-muted">このコードを家族に教えて、アプリに参加してもらいましょう！</p>
  </div>

  <%= link_to "トップへ戻る", root_path, class: "btn btn-outline-secondary" %>
</div>