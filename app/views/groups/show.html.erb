<!-- 🚀 1行目に `style` を追加して、下部タブバーと被らないクッションを作ります -->
<div class="container py-5 text-center pb-5" style="margin-bottom: 120px;">
  <% # グループ名 %>
  <h1 class="display-5 fw-bold" style="color: #7c2d12;"><%= @group.name %></h1>
  
  <% # 招待コードエリア（メインコンテンツ） %>
  <div class="my-5 p-4 bg-light rounded shadow-sm mx-auto" style="max-width: 500px;">
    <p class="mb-1 text-muted small fw-bold">このグループの招待コード</p>
    <h2 class="display-6 fw-bold text-primary my-3" style="letter-spacing: 0.1em;">
      <%= @group.invite_code %>
    </h2>
    <p class="mt-3 small text-muted mb-0">
      このコードを家族に教えて、アプリに参加してもらいましょう！
    </p>
  </div>

  <!-- 🚀 新しいグループを追加するボタンを配置 -->
  <div class="mt-5 mx-auto" style="max-width: 500px;">
    <%= link_to new_group_path, class: "btn btn-outline-dark btn-sm fw-bold rounded-pill px-4 py-2.5 shadow-sm d-inline-flex align-items-center gap-2", style: "border-color: #7c2d12; color: #7c2d12;" do %>
      <span>➕</span> 新しいグループを作成・追加
    <% end %>
  </div>
</div>