<% # 💡 対策1: コンテナ自体に `pb-5`（下方向の大きなパディング）を追加して、フッターがメニューの裏に入り込むのを防ぎます %>
<div class="container py-5 text-center pb-5">
  <% # グループ名 %>
  <h1 class="display-5 fw-bold" style="color: #7c2d12;"><%= @group.name %></h1>
  
  <% # 招待コードエリア（メインコンテンツ） %>
  <div class="my-5 p-4 bg-light rounded shadow-sm mx-auto" style="max-width: 500px;">
    <p class="mb-1 text-muted small fw-bold">このグループの招待コード</p>
    <h2 class="display-6 fw-bold text-primary my-3" style="letter-spacing: 0.1em;">
      <%= @group.invite_code %>
    </h2>
    <p class="mt-3 small text-muted mb-0">
      このコードを家族に教えて、アプリに参加してもわりましょう！
    </p>
  </div>
</div>

<% # ========================================== %>
<% # スマホ用：画面下部固定のボトムナビゲーション %>
<% # ========================================== %>
<div class="fixed-bottom bg-white border-top shadow-lg" style="z-index: 1030; height: 68px; border-radius: 16px 16px 0 0;">
  <div class="d-flex justify-content-around align-items-center h-100 px-2">
    
    <% # 1. ホーム %>
    <%= link_to group_path(@group), class: "nav-btn text-center text-decoration-none flex-grow-1 #{current_page?(group_path(@group)) ? 'active' : ''}" do %>
      <div class="icon-wrapper">🏠</div>
      <div class="nav-label">ホーム</div>
    <% end %>

    <% # 2. ペット詳細 %>
    <%= link_to group_pets_path(@group), class: "nav-btn text-center text-decoration-none flex-grow-1 #{current_page?(group_pets_path(@group)) ? 'active' : ''}" do %>
      <div class="icon-wrapper">🐾</div>
      <div class="nav-label">ペット</div>
    <% end %>

    <% # 3. お世話記録（仮） %>
    <%= link_to '#', class: "nav-btn text-center text-decoration-none flex-grow-1 disabled-btn" do %>
      <div class="icon-wrapper">📋</div>
      <div class="nav-label">お世話</div>
    <% end %>

    <% # 4. メニュー（仮） %>
    <%= link_to '#', class: "nav-btn text-center text-decoration-none flex-grow-1 disabled-btn" do %>
      <div class="icon-wrapper">⚙️</div>
      <div class="nav-label">メニュー</div>
    <% end %>

  </div>
</div>

