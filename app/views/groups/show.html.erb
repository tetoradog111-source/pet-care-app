<div class="container py-5 text-center">
  <h1 class="display-5 fw-bold" style="color: #7c2d12;"><%= @group.name %></h1>
  
  <div class="my-5 p-4 bg-light rounded shadow-sm">
    <p class="mb-1 text-muted">このグループの招待コード</p>
    <h2 class="display-6 fw-bold text-primary" style="letter-spacing: 0.1em;">
      <%= @group.invite_code %>
    </h2>
    <p class="mt-3 small text-muted">このコードを家族に教えて、アプリに参加してもらいましょう！</p>
  </div>

  <%# --- ペット情報エリア --- %>
  <div class="my-5">
    <div class="d-flex justify-content-between align-items-center mb-4 mx-auto" style="max-width: 600px;">
      <h3 class="h4 mb-0 fw-bold" style="color: #7c2d12;">🐾 一緒に暮らすペット</h3>
      
      <%# ペット新規登録ボタン %>
      <%= link_to new_group_pet_path(@group), class: "btn text-white shadow-sm d-inline-flex align-items-center", style: "background-color: #ea580c; border: none;" do %>
        ＋ ペットを登録する
      <% end %>
    </div>

    <%# ペットの一覧表示 %>
    <div class="mx-auto" style="max-width: 600px;">
      <% if @group.pets.any? %>
        <div class="list-group shadow-sm">
          <% @group.pets.each do |pet| %>
            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3">
              <div class="text-start">
                <span class="fw-bold fs-5 text-dark"><%= pet.name %></span>
                <span class="badge bg-secondary ms-2"><%= pet.species %></span>
              </div>
              <span class="text-muted">
              <%= "#{pet.age}歳" if pet.age.present? %> (<%= pet.gender_text %>)
              </span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="card card-body border-0 bg-light p-4 text-muted">
          まだペットが登録されていません。上のボタンから登録してみましょう！
        </div>
      <% end %>
    </div>
  </div>
  <%# --- ここまで --- %>

  <div class="mt-5">
    <%= link_to "トップへ戻る", root_path, class: "btn btn-outline-secondary" %>
  </div>
</div>