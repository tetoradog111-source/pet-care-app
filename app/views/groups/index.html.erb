<div class="container py-5 pb-5" style="margin-bottom: 120px;">
  <div class="text-center mb-5">
    <h1 class="display-6 fw-bold" style="color: #7c2d12;">所属しているグループ</h1>
    <p class="text-muted">お世話するペットのグループを選択してください</p>
  </div>

  <% # 🚀 所属グループのカード一覧（データベースの登録数だけループします） %>
  <div class="row g-4 justify-content-center">
    <% @groups.each do |group| %>
      <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0 rounded-4 p-3" style="background-color: #fffbf7; border-left: 5px solid #7c2d12 !important;">
          <div class="card-body d-flex flex-column justify-content-between">
            <div>
              <h3 class="h4 fw-bold mb-3" style="color: #7c2d12;"><%= group.name %></h3>
              <p class="text-muted small">登録ペット数: <%= group.pets.count %> 匹</p>
            </div>
            
            <div class="mt-4 d-grid gap-2">
              <% # 💡 ペット一覧へ遷移するメインボタン %>
              <%= link_to group_pets_path(group), class: "btn btn-sm text-white fw-bold rounded-pill py-2 shadow-sm", style: "background-color: #7c2d12;" do %>
                ペット一覧をみる
              <% end %>
              
              <div class="d-flex justify-content-between align-items-center mt-2 px-1">
                <% # 💡 招待コードを確認するリンク %>
                <%= link_to group_path(group), class: "btn btn-sm btn-link text-decoration-none fw-bold p-0", style: "color: #7c2d12;" do %>
                  招待コードを確認 🔍
                <% end %>

                <% # 🚀 追加：グループ削除ボタン（文字を小さめにして右側に配置） %>
                <%= link_to group_path(group), 
                            data: { turbo_method: :delete, turbo_confirm: "「#{group.name}」を削除しますか？\n（所属するペットのデータも削除される可能性があります）" }, 
                            class: "btn btn-sm btn-link text-decoration-none fw-bold p-0 text-danger small" do %>
                  削除 🗑️
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% # 🚀 新しいグループを追加するボタン %>
  <div class="text-center mt-5">
    <%= link_to new_group_path, class: "btn btn-outline-dark btn-sm fw-bold rounded-pill px-4 py-2.5 shadow-sm d-inline-flex align-items-center gap-2", style: "border-color: #7c2d12; color: #7c2d12;" do %>
      <span>➕</span> 新しいグループを作成・追加
    <% end %>
  </div>
</div>