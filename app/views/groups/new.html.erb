<% content_for(:title, "グループ作成") %>
<div class="container py-5">
  <div class="row">
    <div class="col-md-8 mx-auto">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <h1 class="text-center mb-4" style="color: #7c2d12;">🐾 新しいグループを作る</h1>
          <p class="text-muted text-center mb-4 small">
            家族や友人とペットのケアを共有するためのグループを作成します。
          </p>

          <%= form_with model: @group, local: true do |f| %>
            <div class="mb-4">
              <%= f.label :name, "グループ名", class: "form-label fw-bold" %>
              <%= f.text_field :name, class: "form-control form-control-lg", placeholder: "例：藤原家、わんわんチーム" %>
            </div>

            <div class="d-grid">
              <%= f.submit "グループを作成する", class: "btn btn-primary btn-lg", style: "background-color: #ea580c; border: none;" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>