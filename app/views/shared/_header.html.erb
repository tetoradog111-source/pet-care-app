<header class="bg-white shadow-sm border-b-4 border-orange-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16 items-center">
      <div class="flex-shrink-0 flex items-center">
        <%= link_to root_path, class: "text-2xl font-bold text-orange-900 flex items-center gap-2" do %>
          <span>🐾</span>
          <span class="hidden md:block">Pet Care Sharing App</span>
        <% end %>
      </div>
      <div class="flex items-center space-x-4">
        <%= link_to "ログイン", "#", class: "text-sm font-medium text-gray-700 hover:text-orange-500" %>
        <%= link_to "新規登録", "#", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-bold rounded-full text-white bg-orange-500 hover:bg-orange-600 shadow-sm transition" %>
      </div>
    </div>
  </div>
</header>