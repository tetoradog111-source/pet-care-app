<% content_for(:title, "ペット一覧") %>

<% if params[:select_calendar] == 'true' %>
  <!-- カレンダータブから来た時だけ表示される特別な案内 -->
  <div class="alert alert-info text-center shadow-sm border-0 mb-4 py-3 mx-auto" style="border-radius: 1rem; background-color: #f0fdf4; color: #166534; max-width: 800px;">
    <h5 class="fw-bold mb-1">📅 どの子のカレンダーを見ますか？</h5>
    <p class="small mb-0 opacity-75">下の一覧から、カレンダーを見たいペットを選んでタップしてください。</p>
  </div>
<% end %>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-5 mx-auto" style="max-width: 800px;">
    <h1 class="h2 fw-bold mb-0" style="color: #7c2d12;">🐾 <%= @group.name %> のペットたち</h1>
    <%= link_to new_group_pet_path(@group), class: "btn text-white shadow-sm", style: "background-color: #ea580c; border: none;" do %>
      ＋ 新しいペットを登録
    <% end %>
  </div>

  <div class="row row-cols-1 row-cols-md-3 g-4 mx-auto" style="max-width: 800px;">
    <% if @pets.any? %>
      <% @pets.each do |pet| %>
        <div class="col">
          <div class="card h-100 shadow-sm border-0 position-relative" style="border-radius: 1rem; overflow: hidden;">
            
            <% # 💡 リンク先の切り替えロジック %>
            <% target_path = params[:select_calendar] == 'true' ? group_pet_care_records_path(@group, pet) : group_pet_path(@group, pet) %>

            <%= link_to target_path, class: "text-decoration-none text-dark h-100 d-flex flex-column" do %>
              <%# ペットの画像枠 %>
              <div class="bg-light d-flex align-items-center justify-content-center" style="height: 160px; background-color: #fef3c7 !important;">
                <span class="display-3">🐶</span>
              </div>
              
              <div class="card-body p-4 text-center d-flex flex-column justify-content-between flex-grow-1">
                <div>
                  <h2 class="card-title h4 fw-bold text-dark mb-2"><%= pet.name %></h2>
                  <span class="badge bg-secondary-subtle text-secondary mb-3 px-3 py-2" style="font-size: 0.85rem;"><%= pet.species %></span>
                </div>
                
                <p class="card-text text-muted small mb-0">
                  <%= "#{pet.age}歳" if pet.age.present? %> 
                  (<%= pet.gender_text %>)
                </p>
              </div>
            <% end %>

          </div>
        </div>
      <% end %>
    <% else %>
      <div class="col-12 text-center py-5">
        <div class="card card-body border-0 bg-light p-5 text-muted">
          <p class="mb-3">まだペットが登録されていません。</p>
          <div>
            <%= link_to "最初のペットを登録する", new_group_pet_path(@group), class: "btn text-white btn-sm", style: "background-color: #ea580c; border: none;" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>