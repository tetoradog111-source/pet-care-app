<div class="container mt-5 pb-5" style="max-width: 800px; margin-bottom: 120px;">

  <div class="row g-4">
    <div class="col-md-5">
      <div class="card shadow-sm border-0 sticky-top" style="top: 2rem;">
        <div class="card-body text-center py-4">
          <div class="display-1 mb-3">🐶</div>
          
          <h2 class="card-title fw-bold mb-1"><%= @pet.name %></h2>
          <span class="badge bg-secondary-subtle text-secondary mb-4 px-3 py-2 rounded-pill"><%= @pet.species %></span>

          <table class="table table-borderless text-start mx-auto mb-4" style="max-width: 240px;">
            <tbody>
              <tr class="border-bottom border-light">
                <th scope="row" class="text-muted fw-normal py-2">年齢</th>
                <td class="fw-bold text-end py-2"><%= @pet.age %> 歳</td>
              </tr>
              <tr>
                <th scope="row" class="text-muted fw-normal py-2">性別</th>
                <td class="fw-bold text-end py-2">
                  <%= @pet.gender_text %>
                </td>
              </tr>
            </tbody>
          </table>

          <div class="d-grid gap-2 px-3">
            <%= link_to "情報を編集する", edit_group_pet_path(@group, @pet), class: "btn btn-outline-dark btn-sm fw-bold rounded-pill" %>
            
            <%= link_to "ファミリーから削除する", group_pet_path(@group, @pet), 
                        class: "text-danger text-decoration-none fw-bold small mt-2 opacity-75 hover-opacity-100", 
                        data: { turbo_method: :delete, turbo_confirm: "本当に#{@pet.name}の情報を削除しますか？\n（登録したお世話項目もすべて削除されます）" } %>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-7">
      <h4 class="fw-bold mb-3 d-flex align-items-center">
        <span class="me-2">🛠️</span> お世話の管理・記録
      </h4>
      
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
          <h6 class="fw-bold text-muted mb-3">ワンタップで今のお世話を記録</h6>
          
          <% if @pet.care_items.select(&:persisted?).any? %>
            <div class="d-flex flex-wrap gap-3">
              <% @pet.care_items.select(&:persisted?).each do |item| %>
                <%# 💡 160pxの固定幅を持たせ、中身を縦方向で綺麗に整列させました %>
                <div class="card border border-light shadow-sm" style="width: 160px;">
                  <div class="card-body text-center p-3 d-flex flex-column justify-content-between" style="min-height: 125px;">
                    <p class="fw-bold mb-2 text-dark text-truncate" title="<%= item.name %>"><%= item.name %></p>
                    
                    <div>
                      <%= button_to "完了", group_pet_care_records_path(@group, @pet, care_item_id: item.id), 
                                    method: :post, 
                                    class: "btn btn-sm btn-dark w-100 rounded-pill fw-bold" %>
                      
                      <div class="mt-2 text-end">
                        <%= link_to group_pet_care_item_path(@group, @pet, item), 
                                    data: { turbo_method: :delete, turbo_confirm: "「#{item.name}」の設定自体を削除しますか？\n（過去の記録もすべて消えます）" }, 
                                    class: "text-decoration-none text-danger x-small opacity-50 hover-opacity-100" do %>
                          項目を削除
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-4 text-muted">
              <p class="mb-1 small">まだお世話項目が登録されていません。</p>
              <p class="mb-0 x-small text-secondary-50">下のフォームから「ごはん」や「散歩」を追加しましょう！</p>
            </div>
          <% end %>
        </div>
      </div>

      <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold text-muted mb-0">🕒 今日のお世話履歴</h6>
            <%= link_to group_pet_care_records_path(@group, @pet), class: "btn btn-outline-success btn-sm rounded-pill fw-bold" do %>
              📅 履歴（カレンダー）を見る
            <% end %>
          </div>
          
          <% today_records = @pet.care_records.where(recorded_at: Time.current.all_day).order(recorded_at: :desc) %>
          
          <% if today_records.any? %>
            <div class="list-group list-group-flush">
              <% today_records.each do |record| %>
                <div class="list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent">
                  <div>
                    <span class="badge bg-success me-2 px-2 py-1.5"><%= record.care_item.name %></span>
                    <span class="small text-dark fw-bold me-2"><%= record.user.name %> さん</span>
                    <span class="x-small text-secondary"><%= l(record.recorded_at, format: :short) %></span>
                  </div>
                  <%= link_to "取り消し", group_pet_care_record_path(@group, @pet, record), 
                              data: { turbo_method: :delete, turbo_confirm: "この記録を削除しますか？" }, 
                              class: "btn btn-link text-danger text-decoration-none btn-sm opacity-75 fw-bold" %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted text-center py-3 mb-0 small">今日のお世話はまだ記録されていません。</p>
          <% end %>
        </div>
      </div>

      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <h6 class="fw-bold text-muted mb-3">新しいお世話項目（選択肢）を増やす</h6>
          
          <%= form_with(model: [@group, @pet, @care_item], local: true, class: "row g-2") do |f| %>
            <div class="col">
              <%= f.text_field :name, class: "form-control form-control-sm", placeholder: "例: ブラッシング、耳掃除、サプリ、投薬" %>
            </div>
            <div class="col-auto">
              <%= f.submit "項目を追加", class: "btn btn-outline-dark btn-sm fw-bold px-3" %>
            </div>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>