<div class="min-h-screen bg-orange-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md text-center">
    <!-- ロゴ代わりのアイコン（絵文字で代用） -->
    <div class="text-6xl mb-4">🐾</div>
    <h2 class="text-3xl font-extrabold text-orange-900 tracking-tight">
      Pet Care Sharing App
    </h2>
    <p class="mt-2 text-sm text-orange-700">
      お世話のバトンを、もっとスムーズに。
    </p>
  </div>

  <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
    <div class="bg-white py-8 px-4 shadow-xl rounded-3xl sm:px-10 border-t-8 border-orange-400">
      
      <!-- ログインフォーム -->
      <%= form_with url: "#", local: true, class: "space-y-6" do |f| %>
        <div>
          <%= f.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1">
            <%= f.email_field :email, class: "appearance-none block w-full px-3 py-3 border border-orange-200 rounded-xl shadow-sm focus:ring-orange-500 focus:border-orange-500" %>
          </div>
        </div>

        <div>
          <%= f.label :password, "パスワード", class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1">
            <%= f.password_field :password, class: "appearance-none block w-full px-3 py-3 border border-orange-200 rounded-xl shadow-sm focus:ring-orange-500 focus:border-orange-500" %>
          </div>
        </div>

        <div>
          <%= f.submit "ログイン", class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-full shadow-sm text-base font-bold text-white bg-orange-500 hover:bg-orange-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-500 transition duration-150" %>
        </div>
      <% end %>

      <!-- 区切り線 -->
      <div class="mt-6 relative">
        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-gray-200"></div></div>
        <div class="relative flex justify-center text-sm"><span class="px-2 bg-white text-gray-400">はじめての方はこちら</span></div>
      </div>

      <div class="mt-6">
        <%= link_to "新規登録（無料）", "#", class: "w-full flex justify-center py-3 px-4 border-2 border-orange-400 rounded-full text-base font-bold text-orange-500 bg-white hover:bg-orange-50 transition duration-150" %>
      </div>
    </div>
    
    <!-- 補足メッセージ -->
    <p class="mt-8 text-center text-xs text-gray-500">
      大切な家族のお世話を、みんなでシェア。
    </p>
  </div>
</div>