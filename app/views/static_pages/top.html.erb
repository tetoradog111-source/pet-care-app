<div class="min-vh-100 d-flex align-items-center justify-content-center py-5" style="background-color: #fffaf0;">
  <%# 全体を縦長に収めるためのコンテナ %>
  <div class="container" style="max-width: 450px;">
    
    <!-- ロゴ・ヘッダー部分（上中央・縦並び） -->
    <div class="text-center mb-4">
      <div style="font-size: 4.5rem;" class="mb-2">🐾</div>
      <h2 class="fw-bold tracking-tight" style="color: #7c2d12; font-size: 1.8rem;">
        Pet Care Sharing App
      </h2>
      <p class="small" style="color: #ea580c;">
        お世話のバトンを、もっとスムーズに。
      </p>
    </div>

    <!-- カード部分 -->
    <div class="bg-white p-4 p-sm-5 shadow-lg border-top border-5" 
         style="border-color: #fb923c !important; border-radius: 2.5rem !important;">
      
      <%= form_with url: login_path, local: true do |f| %>
        <div class="mb-4">
          <%= f.label :email, "メールアドレス", class: "form-label fw-bold text-muted small ms-2" %>
          <%= f.email_field :email, class: "form-control form-control-lg border-light-subtle rounded-4 px-3", 
              style: "background-color: #fcfcfc; font-size: 0.9rem;" %>
        </div>

        <div class="mb-4">
          <%= f.label :password, "パスワード", class: "form-label fw-bold text-muted small ms-2" %>
          <%= f.password_field :password, class: "form-control form-control-lg border-light-subtle rounded-4 px-3", 
              style: "background-color: #fcfcfc; font-size: 0.9rem;" %>
        </div>

        <div class="d-grid gap-2 mt-4">
          <%= f.submit "ログイン", class: "btn btn-lg fw-bold text-white shadow-sm rounded-pill py-3", 
              style: "background-color: #f97316; border: none; font-size: 1rem;" %>
        </div>
      <% end %>

      <!-- 区切り線 -->
      <div class="position-relative my-4 text-center">
        <hr class="text-secondary-opacity-25">
        <span class="position-absolute top-50 start-50 translate-middle px-3 bg-white text-muted" style="font-size: 0.75rem;">
          はじめての方はこちら
        </span>
      </div>

      <div class="d-grid gap-2">
        <%= link_to "新規登録（無料）", signup_path, 
            class: "btn btn-lg btn-outline-warning fw-bold rounded-pill py-3", 
            style: "color: #f97316; border-color: #fb923c; font-size: 1rem;" %>
      </div>
    </div>
    
    <!-- 下部の補足メッセージ -->
    <p class="mt-4 text-center text-muted" style="font-size: 0.7rem;">
      大切な家族のお世話を、みんなでシェア。
    </p>
  </div>
</div>